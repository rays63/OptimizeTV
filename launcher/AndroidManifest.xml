<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="tv.local.ytredirect" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="31" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Granted over adb (pm grant): lets Home turn the remote helper back on after a reboot resets it -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <queries>
        <package android:name="org.smarttube.stable" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.spotify.tv.android" />
    </queries>
    <application android:label="@string/app_name">
        <activity android:name=".HomeActivity" android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:launchMode="singleTask" android:stateNotNeeded="true"
            android:screenOrientation="landscape" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".AllAppsActivity" android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />
        <activity android:name=".SettingsActivity" android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:windowSoftInputMode="adjustPan|stateAlwaysHidden" />
        <activity android:name=".SwitcherActivity" android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen"
            android:launchMode="singleTask" android:taskAffinity="tv.local.ytredirect.switcher"
            android:excludeFromRecents="true" android:noHistory="false" />
        <service android:name=".RedirectService" android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/service_config" />
        </service>
            <!-- Never opened. RedirectService.ensureEnabled flips it so Android sees a package change and
             re-reads the accessibility settings (on the TCL it stops watching them after a reboot). -->
        <activity-alias android:name=".Nudge" android:targetActivity=".SettingsActivity"
            android:enabled="false" android:exported="false" />
</application>
</manifest>
